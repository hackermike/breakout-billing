DATABASE_URL=sqlite:///./breakout.db

# Optional: session-signing key. If unset, a random key is generated and saved
# to .secret_key on first run. Set this to keep sessions stable across machines.
# SECRET_KEY=change-me-to-a-long-random-string

# Optional: email for appointment reminders (see docs/EMAIL-SETUP.md).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
